datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid()) @map("_id")
  email              String              @unique
  passwordHash       String
  name               String
  role               String              // "STAFF" | "HOD" | "ADMIN"
  isClassCoordinator Boolean             @default(false)
  department         String              // e.g., "Computer Science"
  assignedClassId    String?             // e.g., "CSE-B" (null for Principal/HOD unless assigned)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  weeklyPlans        WeeklyPlan[]
  progressLogs       ProgressLog[]
  extraHourRequests  ExtraHourRequest[]
  timetableSlots     TimetableSlot[]
}

model TimetableSlot {
  id           String   @id @default(uuid()) @map("_id")
  dayOfWeek    String   // e.g., "Monday"
  period       Int      // e.g., 1
  subjectCode  String   // e.g., "CS8501"
  subjectName  String   // e.g., "Theory of Computation"
  classSection String   // e.g., "CSE-B"
  roomNo       String   // e.g., "LH-302"
  facultyId    String
  faculty      User     @relation(fields: [facultyId], references: [id])
}

model SyllabusNode {
  id          String   @id @map("_id")
  subjectCode String   // e.g., "CS8501"
  unit        String   // e.g., "Unit 1"
  topicId     String   @unique
  topicTitle  String
}

model WeeklyPlan {
  id                 String   @id @map("_id")
  academicWeekNumber Int
  subjectCode        String
  targetTopicIds     String   // Comma-separated list of topic IDs
  status             String   // "DRAFT" | "SUBMITTED" | "APPROVED"
  isDraft            Boolean  @default(true)
  facultyId          String
  faculty            User     @relation(fields: [facultyId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProgressLog {
  id                  String   @id @map("_id")
  facultyId           String
  faculty             User     @relation(fields: [facultyId], references: [id])
  subjectCode         String
  classId             String
  academicWeekNumber  Int
  completedTopicIds   String   // Comma-separated list of topic IDs
  pendingTopicIds     String   // Comma-separated list of topic IDs
  reasonsForPending   String?
  extraHoursRequested Boolean  @default(false)
  submittedAt         DateTime @default(now())
}

model ExtraHourRequest {
  id            String   @id @map("_id")
  facultyId     String
  faculty       User     @relation(fields: [facultyId], references: [id])
  subjectCode   String
  classId       String
  requestedDate String   // YYYY-MM-DD
  period        Int
  reason        String
  status        String   // "PENDING" | "APPROVED" | "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ConsolidatedReport {
  id              String   @id @map("_id")
  classId         String   // e.g., "CSE-B"
  weekNumber      Int
  overallCoverage Int
  submittedBy     String   // e.g., "Dr. Meena Kumari"
  submittedAt     String   // YYYY-MM-DD
  ccRemarks       String
  status          String   // "PENDING_CC" | "SUBMITTED_TO_HOD" | "APPROVED_BY_HOD" | "SENT_TO_ADMIN" | "REJECTED_BY_HOD" | "RETURNED_BY_HOD"
  subjectsJson    String   // Serialized JSON of SubjectProgress[] for simplicity and flexibility
  hodRemarks      String?
  approvedAt      String?
}
