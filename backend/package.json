{
  "name": "ccr-backend",
  "version": "1.0.0",
  "description": "Backend API for Course Coverage Report (CCR)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/config/defaults', {recursive:true}); fs.copyFileSync('src/config/defaults/defaultRelease.json', 'dist/config/defaults/defaultRelease.json'); fs.copyFileSync('src/config/defaults/defaultConfig.json', 'dist/config/defaults/defaultConfig.json');\"",
    "test": "ts-node src/__tests__/algorithms.test.ts && ts-node src/__tests__/appRelease.test.ts",
    "release:publish": "ts-node scripts/publishRelease.ts",
    "version:bump": "ts-node scripts/bumpVersion.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
